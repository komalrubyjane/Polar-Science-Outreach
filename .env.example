# ---------------------------------------------------------------------------
# Integrated Polar Science Outreach Portal — Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------
#
# DEPLOYING ON VERCEL (or any host): set these in the project's
# Environment Variables UI — the build fails without them because the app
# validates its config at boot (src/lib/env.ts). Blank values are treated
# as "unset" and fall back to the defaults below; only DATABASE_URL has no
# default and MUST be provided.
#
#   REQUIRED : DATABASE_URL
#   STRONGLY RECOMMENDED : DIRECT_URL, AUTH_SECRET (a real 32-byte secret),
#                          NEXT_PUBLIC_APP_URL (your deployed https URL)
#   OPTIONAL : DEMO_MODE=false, NASA_EARTHDATA_TOKEN, NOAA_API_TOKEN,
#              CLIMATE_DATA_API_URL, UNSPLASH_ACCESS_KEY, …
#
# The seed-account vars (ADMIN_EMAIL/PASSWORD, …) are only used by
# `npm run db:seed`; they are NOT needed for the build or runtime.
# ---------------------------------------------------------------------------

# --- Application ---
# Public base URL of the deployment (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local dev:  postgresql://polar:polar@localhost:5432/polar_portal?schema=public
# Supabase:   use the "Connection pooling" (Transaction) URI for DATABASE_URL and
#             the "Direct connection" URI for DIRECT_URL (used by migrations).
DATABASE_URL=postgresql://polar:polar@localhost:5432/polar_portal?schema=public
# Optional. Direct (non-pooled) connection for `prisma migrate` / `db push`.
# Leave blank to reuse DATABASE_URL.
DIRECT_URL=

# --- Authentication (Auth.js / NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
# Trust the host header (required behind proxies / in Docker)
AUTH_TRUST_HOST=true

# --- Google OAuth (optional — leave blank to disable the Google button) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Seed / bootstrap admin account (used by `npm run db:seed`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
EDITOR_EMAIL=editor@example.com
EDITOR_PASSWORD=ChangeThisPassword123!
RESEARCHER_EMAIL=researcher@example.com
RESEARCHER_PASSWORD=ChangeThisPassword123!
USER_EMAIL=user@example.com
USER_PASSWORD=ChangeThisPassword123!

# --- File Storage ---
# STORAGE_PROVIDER = "local" | "s3"
STORAGE_PROVIDER=local
# Local provider: files are written under this directory and served via /api/files
LOCAL_STORAGE_DIR=./storage
# S3 / R2 / MinIO compatible settings (used when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Public base URL for objects, if the bucket is CDN-fronted (optional)
S3_PUBLIC_URL=

# --- Maps ---
# Optional tile provider API key (MapTiler / Stadia / etc). Blank = use OpenStreetMap default tiles.
NEXT_PUBLIC_MAP_API_KEY=
NEXT_PUBLIC_MAP_TILE_URL=

# --- Email (transactional: verification, password reset, notifications) ---
# SMTP connection string: smtp://user:pass@host:port
EMAIL_SERVER=
EMAIL_FROM="Polar Science Portal <no-reply@example.com>"

# --- Rate limiting ---
# Requests per window per IP for write/auth endpoints
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Analytics ---
# Set to "false" to disable product analytics collection entirely
ANALYTICS_ENABLED=true

# --- Demo mode ---
# PRODUCTION MUST BE FALSE. When false, real data is the only source and gaps
# show honest "data unavailable" states. true = fill gaps with bundled demo
# content (design preview / local development only).
DEMO_MODE=false

# --- Scientific data sources ---
# Sea ice works with no key: it reads the public NSIDC Sea Ice Index (v3) CSVs.
NSIDC_SEA_ICE_API_URL=https://noaadata.apps.nsidc.org/NOAA/G02135
# Optional JSON endpoints returning { points: [{t,value}], ... } for other domains:
CLIMATE_DATA_API_URL=
OCEAN_DATA_API_URL=
# NASA Earthdata (server-side only; token never exposed to the browser):
NASA_EARTHDATA_API_URL=
NASA_EARTHDATA_TOKEN=
# NOAA (server-side only):
NOAA_API_URL=
NOAA_API_TOKEN=
# US Antarctic Program data catalogue:
USAP_API_URL=https://www.usap-dc.org/view/dataset

# --- Editorial imagery (optional, server-side only) ---
# Curated Unsplash imagery works without any key. Set a key only to enable
# in-app image search for editors. NEVER prefix these with NEXT_PUBLIC_.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
